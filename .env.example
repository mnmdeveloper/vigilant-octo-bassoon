# Create the bot with @BotFather.
BOT_TOKEN=

# Your numeric Telegram user ID. Only this user can control the bot.
ADMIN_ID=

# Optional for importing an authorized Pyrogram/Pyrofork .session.
# Required only for a new phone login or a legacy Telethon account.
# Create these at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Conservative delay between messages.
SEND_DELAY_SECONDS=4
